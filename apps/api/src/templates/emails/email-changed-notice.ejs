<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email address changed</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f7fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7fa;padding:40px 20px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);padding:32px 40px;text-align:center;">
              <div style="width:56px;height:56px;background:rgba(255,255,255,0.2);border-radius:14px;display:inline-block;line-height:56px;font-size:28px;">🔔</div>
              <h1 style="margin:16px 0 0;color:#ffffff;font-size:20px;font-weight:700;">Email address changed</h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:36px 40px 20px;">
              <p style="margin:0 0 20px;color:#4b5563;font-size:15px;line-height:1.6;">
                Hi <%= displayName %>,
              </p>
              <p style="margin:0 0 24px;color:#4b5563;font-size:15px;line-height:1.6;">
                Your OldPickleball account email has been successfully changed.
                This email address (<strong><%= oldEmail %></strong>) is no longer associated with your account.
              </p>
            </td>
          </tr>

          <!-- Details card -->
          <tr>
            <td style="padding:0 40px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:10px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding:4px 0;">
                          <span style="color:#9ca3af;font-size:13px;">Previous email</span><br>
                          <span style="color:#6b7280;font-size:14px;"><%= oldEmail %></span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:8px 0 0;">
                          <span style="color:#9ca3af;font-size:13px;">New email</span><br>
                          <span style="color:#1a1a2e;font-size:14px;font-weight:600;"><%= newEmail %></span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:8px 0 0;">
                          <span style="color:#9ca3af;font-size:13px;">Changed at</span><br>
                          <span style="color:#6b7280;font-size:14px;"><%= changedAt %></span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Warning -->
          <tr>
            <td style="padding:0 40px 36px;">
              <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px 18px;">
                <p style="margin:0;color:#991b1b;font-size:13px;line-height:1.5;">
                  <strong>Didn't make this change?</strong> Your account may be compromised.
                  Please sign in with your new email immediately and contact support.
                </p>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:0 40px;"><div style="height:1px;background:#e5e7eb;"></div></td>
          </tr>
          <tr>
            <td style="padding:24px 40px 32px;text-align:center;">
              <p style="margin:0 0 4px;color:#9ca3af;font-size:12px;">OldPickleball — Find courts, join games, play more.</p>
              <p style="margin:0;color:#d1d5db;font-size:11px;">© <%= new Date().getFullYear() %> OldPickleball. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
