<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify your new email</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f7fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7fa;padding:40px 20px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#3b82f6 0%,#1d4ed8 100%);padding:32px 40px;text-align:center;">
              <div style="width:56px;height:56px;background:rgba(255,255,255,0.2);border-radius:14px;display:inline-block;line-height:56px;font-size:28px;">📧</div>
              <h1 style="margin:16px 0 0;color:#ffffff;font-size:20px;font-weight:700;">Confirm your new email</h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:36px 40px 20px;">
              <p style="margin:0 0 8px;color:#4b5563;font-size:15px;line-height:1.6;text-align:center;">
                You requested to change your OldPickleball email to this address.
                Enter the code below to confirm:
              </p>
            </td>
          </tr>

          <!-- OTP Code -->
          <tr>
            <td style="padding:0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center">
                    <div style="background:#eff6ff;border:2px solid #bfdbfe;border-radius:12px;padding:20px 32px;display:inline-block;">
                      <span style="font-family:'SF Mono','Cascadia Code','Fira Code',monospace;font-size:36px;font-weight:800;letter-spacing:8px;color:#1d4ed8;">
                        <%= otpCode %>
                      </span>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Context -->
          <tr>
            <td style="padding:20px 40px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:10px;padding:16px;">
                <tr>
                  <td style="padding:12px 16px;">
                    <p style="margin:0 0 6px;color:#6b7280;font-size:13px;">Changing email for account:</p>
                    <p style="margin:0;color:#1a1a2e;font-size:14px;font-weight:600;"><%= currentEmail %></p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiry -->
          <tr>
            <td style="padding:8px 40px 12px;" align="center">
              <div style="background:#fef3c7;border-radius:8px;padding:10px 16px;display:inline-block;">
                <span style="color:#92400e;font-size:13px;font-weight:500;">⏳ This code expires in <%= expiryMinutes %> minutes</span>
              </div>
            </td>
          </tr>

          <!-- Security -->
          <tr>
            <td style="padding:12px 40px 36px;">
              <p style="margin:0;color:#9ca3af;font-size:13px;line-height:1.5;text-align:center;">
                If you didn't request this change, ignore this email. Your account email will remain unchanged.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:0 40px;"><div style="height:1px;background:#e5e7eb;"></div></td>
          </tr>
          <tr>
            <td style="padding:24px 40px 32px;text-align:center;">
              <p style="margin:0 0 4px;color:#9ca3af;font-size:12px;">OldPickleball — Find courts, join games, play more.</p>
              <p style="margin:0;color:#d1d5db;font-size:11px;">© <%= new Date().getFullYear() %> OldPickleball. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
