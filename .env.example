# Maps (choose one)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Mailgun)
MAILGUN_API_KEY=
MAILGUN_PROXY_EMAIL=noreply@yourdomain.com
MAILGUN_DOMAIN=
OTP_EXPIRY_MINUTES=10
